#pragma once

#include <iostream>
#include <memory>

#include "lime/displayable.h"

namespace mosh
{
    class Metabolite : public lime::Displayable
    {
    public:
        Metabolite(
            std::string name, size_t compartment,
            double rate_lb = 0.0f, double rate_ub = 0.0f
        ) :
            Displayable(),
            name_(name),
            compartment_(compartment),
            rate_lb_(),
            rate_ub_()
        {
        }

        std::string name() const override {return name_;}
        size_t compartment() const {return compartment_;}
        size_t index() const {return index_;}
        void set_index (size_t index) {index_ = index;}
        double rate_lb(size_t experiment) const {
            if (experiment >= rate_lb_.size())
                return 0.0f;
            return rate_lb_[experiment];
        }
        double rate_ub(size_t experiment) const {
            if (experiment >= rate_ub_.size())
                return 0.0f;
            return rate_ub_[experiment];
        }
        void set_rate_lb (size_t experiment, double rate_lb) {
            if (rate_lb_.size() <= experiment) {
                rate_lb_.resize (experiment + 1, 0.0f);
            }
            rate_lb_[experiment] = rate_lb;
        }
        void set_rate_ub (size_t experiment, double rate_ub) {
            if (rate_ub_.size() <= experiment) {
                rate_ub_.resize (experiment + 1, 0.0f);
            }
            rate_ub_[experiment] = rate_ub;
        }
    
    private:
        std::string name_;
        size_t compartment_;
        size_t index_;
        std::vector<double> rate_lb_;
        std::vector<double> rate_ub_;
    };
    
    using MetabolitePtr = std::shared_ptr<Metabolite>;
}
